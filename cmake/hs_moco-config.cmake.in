@PACKAGE_INIT@

# ─────────────────────────────────────────────────────────────────────────────
# hs_moco-config.cmake — package configuration for find_package(hs_moco)
# ─────────────────────────────────────────────────────────────────────────────

include(CMakeFindDependencyMacro)

# Gurobi must be found by downstream consumers as well.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(GUROBI)

include("${CMAKE_CURRENT_LIST_DIR}/hs_moco-targets.cmake")

check_required_components(hs_moco)
